# Copy to .env. Required — the build fails without it.
VITE_API_BASE_URL=https://talim-be-dev.onrender.com

# Avatar uploads go straight from the browser to Cloudinary. Optional: when either
# value is missing the "change photo" control is hidden rather than broken.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
